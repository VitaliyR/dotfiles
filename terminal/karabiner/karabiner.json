{
  "global": {
    "show_in_menu_bar": true
  },
  "profiles": [
    {
      "complex_modifications": {
        "rules": [
          {
            "description": "Right Command + 1: toggle Mail and Calendar",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "1",
                  "modifiers": {
                    "mandatory": ["right_command"],
                    "optional": ["any"]
                  }
                },
                "to": [
                  {
                    "software_function": {
                      "open_application": {
                        "bundle_identifier": "com.apple.iCal"
                      }
                    }
                  }
                ],
                "conditions": [
                  {
                    "type": "frontmost_application_if",
                    "bundle_identifiers": ["^com\\.apple\\.mail$"]
                  }
                ]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "1",
                  "modifiers": {
                    "mandatory": ["right_command"],
                    "optional": ["any"]
                  }
                },
                "to": [
                  {
                    "software_function": {
                      "open_application": {
                        "bundle_identifier": "com.apple.mail"
                      }
                    }
                  }
                ],
                "conditions": [
                  {
                    "type": "frontmost_application_unless",
                    "bundle_identifiers": ["^com\\.apple\\.mail$"]
                  }
                ]
              }
            ]
          },
          {
            "description": "Right Command + 2: open Brave",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "2",
                  "modifiers": {
                    "mandatory": ["right_command"],
                    "optional": ["any"]
                  }
                },
                "to": [
                  {
                    "software_function": {
                      "open_application": {
                        "bundle_identifier": "com.brave.Browser"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "devices": [
        {
          "identifiers": {
            "device_address": "f4-50-a1-39-ad-4f",
            "is_keyboard": true,
            "is_pointing_device": true
          },
          "ignore": false,
          "treat_as_built_in_keyboard": true
        }
      ],
      "name": "Default profile",
      "selected": true,
      "virtual_hid_keyboard": {
        "keyboard_type_v2": "ansi"
      }
    }
  ]
}
